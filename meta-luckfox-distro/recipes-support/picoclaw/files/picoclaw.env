# /etc/default/picoclaw — PicoClaw secrets.
#
# This file is mode 0640 root:picoclaw so the service user can read it but
# not the world. The picoclaw.service unit loads it via EnvironmentFile= and
# /usr/libexec/picoclaw-start substitutes the values into the config
# template at start time. Secrets are NEVER written to eMMC — the rendered
# config lives on /run/picoclaw (tmpfs), wiped every reboot.
#
# To enable picoclaw:
#   1. Create a Telegram bot with @BotFather, get the token.
#   2. Get your Telegram numeric user ID from @userinfobot.
#   3. Replace CHANGEME_TELEGRAM_BOT_TOKEN below with your real bot token.
#   4. Replace CHANGEME_ANTHROPIC_API_KEY with your Claude API key (or switch
#      to a different provider — see /etc/picoclaw/README.md).
#   5. Edit /etc/picoclaw/config.json.tmpl: add your user ID to the
#      "allow_from": [] array under channels.telegram.
#   6. systemctl restart picoclaw

TELEGRAM_BOT_TOKEN=CHANGEME_TELEGRAM_BOT_TOKEN

# Active LLM provider — one of these must be un-CHANGEME'd, and the matching
# entry must appear in /etc/picoclaw/config.json.tmpl under model_list.
ANTHROPIC_API_KEY=CHANGEME_ANTHROPIC_API_KEY

# Alternative providers. Uncomment + set the key for the one you're using,
# and edit config.json.tmpl's model_list to match. See README.md for the
# exact JSON snippets.
#OPENAI_API_KEY=
#GOOGLE_API_KEY=
#DEEPSEEK_API_KEY=
#GROQ_API_KEY=
