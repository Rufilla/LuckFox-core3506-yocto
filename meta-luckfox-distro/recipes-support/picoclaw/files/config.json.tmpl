{
  "agents": {
    "defaults": {
      "workspace": "/var/lib/picoclaw/workspace",
      "restrict_to_workspace": false,
      "model_name": "claude",
      "max_tokens": 4096,
      "context_window": 100000,
      "temperature": 0.3,
      "max_tool_iterations": 10,
      "summarize_message_threshold": 40,
      "summarize_token_percent": 70,
      "split_on_marker": false,
      "tool_feedback": { "enabled": true, "max_args_length": 256 }
    }
  },

  "model_list": [
    {
      "model_name": "claude",
      "model": "anthropic/claude-sonnet-4-6",
      "api_keys": ["${ANTHROPIC_API_KEY}"]
    }
  ],

  "channels": {
    "telegram": {
      "enabled": true,
      "token": "${TELEGRAM_BOT_TOKEN}",
      "allow_from": [],
      "use_markdown_v2": false
    }
  },

  "tools": {
    "allow_read_paths": [
      "/var/lib/picoclaw/workspace",
      "/sys/class/net",
      "/sys/class/thermal",
      "/proc"
    ],
    "allow_write_paths": [
      "/var/lib/picoclaw/workspace"
    ],

    "web": {
      "enabled": true,
      "fetch_limit_bytes": 1048576,
      "provider": "duckduckgo",
      "duckduckgo": { "enabled": true, "max_results": 5 }
    },
    "web_fetch": { "enabled": true },
    "read_file": { "enabled": true, "mode": "safe" },
    "list_dir": { "enabled": true },
    "find_skills": { "enabled": true },
    "message": { "enabled": true },
    "cron": { "enabled": true, "exec_timeout_minutes": 5 },

    "write_file":  { "enabled": true },
    "append_file": { "enabled": true },
    "edit_file":   { "enabled": true },

    "exec":          { "enabled": false },
    "spawn":         { "enabled": false },
    "install_skill": { "enabled": false },
    "subagent":      { "enabled": false },
    "i2c":           { "enabled": false },
    "spi":           { "enabled": false },
    "skills":        { "enabled": true },

    "mcp": {
      "enabled": true,
      "servers": {
        "foxbridge": {
          "enabled": true,
          "type": "http",
          "url": "http://127.0.0.1:45521/mcp"
        }
      }
    }
  },

  "heartbeat": { "enabled": true, "interval": 30 },
  "devices":   { "enabled": true, "monitor_usb": true },

  "gateway": {
    "host": "127.0.0.1",
    "port": 45520,
    "log_level": "info"
  }
}
