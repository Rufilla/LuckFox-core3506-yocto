[Unit]
Description=PicoClaw AI agent
Documentation=https://github.com/sipeed/picoclaw file:///etc/picoclaw/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=picoclaw
Group=picoclaw

Environment=PICOCLAW_HOME=/var/lib/picoclaw
Environment=PICOCLAW_CONFIG=/run/picoclaw/config.json
Environment=PICOCLAW_LOG_LEVEL=info
EnvironmentFile=-/etc/default/picoclaw

ExecStart=/usr/libexec/picoclaw-start

Restart=on-failure
RestartSec=10s

# Hardening — read-only filesystem except for explicit writable paths.
# /var/lib/picoclaw holds workspace state (sessions, memory, cron DB).
# /run/picoclaw holds the rendered config (secrets substituted in at start
# time; tmpfs-backed so secrets never land on eMMC).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
StateDirectory=picoclaw
StateDirectoryMode=0750
RuntimeDirectory=picoclaw
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
