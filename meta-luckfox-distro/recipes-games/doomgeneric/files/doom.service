[Unit]
Description=Doom on the DSI framebuffer panel
# Start late, after userspace is up and USB HID has had a chance to enumerate
# (the fb backend grabs evdev keyboards once, at startup).
After=multi-user.target systemd-user-sessions.service
# Only run if a screen is detected: /dev/fb0 only appears once the DRM fbdev
# emulation has a connected panel + a valid mode (no panel -> no fb0).
ConditionPathExists=/dev/fb0

[Service]
Type=simple
# 5s startup delay. The fb backend scans /dev/input once at launch, so this is
# the window to have a keyboard ready: plug a USB keyboard in before boot and
# it's interactive; otherwise Doom runs the attract demo. Keeps both modes
# available without forcing one or the other.
# NB: don't gate on /sys/class/drm/card0-DSI-1/status — it reads "unknown"
# until a DRM client probes the connector, so it's not a reliable boot check.
# /dev/fb0 (ConditionPathExists above) is the dependable "screen present" gate.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/doom
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
