# Persistent U-Boot environment in eMMC — OTA A/B foundation.
# See OTA_SWUPDATE_PLAN.md (milestone M1).
#
# The vendor 2017.09 defconfig builds with ENV_IS_NOWHERE: the environment
# lives in RAM only, `saveenv` does not persist, and there is no bootcount.
# OTA slot selection + rollback need a persistent env that BOTH U-Boot and the
# Linux libubootenv tools (fw_setenv / fw_printenv) read from the same place.
#
# Placement: a raw region in the 8-16 MiB "loader gap" of the eMMC user area.
# Current layout: idbloader @ 32 KiB, u-boot.img @ 8 MiB (~0.8 MiB actual),
# boot partition @ 16 MiB. So 12 MiB (0xC00000) is well clear of u-boot.img and
# the boot partition, and stays valid under the future A/B layout (loader region
# kept <= 16 MiB).
#
#   env: 0xC00000 (12 MiB), size 0x8000 (32 KiB)
#
# env device defaults to mmc dev 0 (the boot eMMC) via env/mmc.c — this fork has
# no SYS_MMC_ENV_DEV Kconfig symbol (it's a header default), which is what we want.
# /etc/fw_env.config in the rootfs MUST mirror this exact offset/size.
#
# NOTE: a REDUNDANT env copy (power-fail-during-saveenv hardening) is NOT enabled.
# CONFIG_SYS_REDUNDAND_ENVIRONMENT / CONFIG_ENV_OFFSET_REDUND are header-driven (not
# Kconfig) in this 2017.09 fork, so they need a board-header patch — deferred as M1
# hardening (see OTA_SWUPDATE_PLAN.md). Single env is acceptable for M1: a corrupt
# env just falls back to the built-in default (boots slot A), not a brick.

CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_OFFSET=0xC00000
CONFIG_ENV_SIZE=0x8000
CONFIG_CMD_SAVEENV=y
