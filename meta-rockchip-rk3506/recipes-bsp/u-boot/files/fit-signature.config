# RK3506 FIT-signature enablement.
# Merged only when RK3506_TEE_FIT_SIGNATURE = "1".
#
# CONFIG_FIT_SIGNATURE   -> builds a signing-capable host mkimage (links
#                          libcrypto; needs openssl-native in DEPENDS).
# CONFIG_SPL_FIT_SIGNATURE -> the SPL verifies the FIT config signature
#                          against the RSA pubkey embedded in its control
#                          DTB, and refuses to boot an unsigned/wrong-key
#                          FIT. Enforced un-fused (no OTP burn needed).
#
# The remaining crypto deps (CONFIG_RSA / SPL_RSA / FIT_HW_CRYPTO /
# SPL_ROCKCHIP_SECURE_OTP) are already =y in rk3506_defconfig.
CONFIG_FIT_SIGNATURE=y
CONFIG_SPL_FIT_SIGNATURE=y
