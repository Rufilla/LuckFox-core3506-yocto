# Enable commands required for distro boot (extlinux.conf / boot.scr)
CONFIG_BOOTDELAY=3
CONFIG_CMD_PART=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y
CONFIG_CMD_PXE=y
# setexpr: integer math for the A/B boot.scr try-counter decrement
# (BOOT_x_LEFT). The vendor defconfig omits it. See OTA_SWUPDATE_PLAN.md.
CONFIG_CMD_SETEXPR=y

# Console baud rate — must match kernel FIQ debugger (rockchip,baudrate
# in DTS) and Yocto KERNEL_CONSOLE/SERIAL_CONSOLES. Vendor defconfig
# defaults to 1500000; override to standard 115200 so cheap USB-serial
# adapters (CH340, CP2102, FT232 basic) can see U-Boot output — many of
# them top out around 230400 baud.
CONFIG_BAUDRATE=115200

# Disable the Rockchip preloader ATAG_SERIAL path in U-Boot. Without this,
# U-Boot's arch/arm/mach-rockchip/param.c:param_parse_pre_serial() reads
# baudrate/uart-address from the ATAG set by the TPL DDR init blob, which
# hardcodes 1500000 baud — overriding CONFIG_BAUDRATE entirely. With this
# disabled, U-Boot falls through to using CONFIG_BAUDRATE + CONFIG_DEBUG_UART_BASE
# directly. The TPL DDR blob and the OP-TEE blob still print at 1500000
# (they are closed-source blobs we cannot recompile), so expect ~1 second
# of garble at the very start of boot; from U-Boot SPL onwards everything
# is at 115200.
# CONFIG_ROCKCHIP_PRELOADER_SERIAL is not set
