#!/bin/sh
# Core3506 secure-boot initramfs init: open the dm-verity root, then switch_root.
# Activates the dm-verity root from the baked-in (authenticated) /etc/verity.conf
# — no dm-mod.create on the kernel cmdline — then switch_root into it.
PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc     proc     /proc    2>/dev/null
mount -t sysfs    sysfs    /sys     2>/dev/null
mount -t devtmpfs devtmpfs /dev     2>/dev/null

rescue() { echo "initramfs: $1 — dropping to shell"; exec /bin/sh; }

# Wait for the data + hash block devices to appear.
for i in $(seq 1 100); do
    [ -b /dev/mmcblk0p2 ] && [ -b /dev/mmcblk0p3 ] && break
    sleep 0.1
done

/sbin/dm-verity-open /etc/verity.conf || rescue "dm-verity-open failed"

# devtmpfs creates the dm device node as /dev/dm-0 (the /dev/mapper/<name>
# symlink is a udev artifact we don't have in this minimal initramfs).
for i in $(seq 1 50); do [ -b /dev/dm-0 ] && break; sleep 0.1; done
[ -b /dev/dm-0 ] || rescue "/dev/dm-0 did not appear"

mkdir -p /mnt/root
mount -o ro /dev/dm-0 /mnt/root || rescue "mount verified root failed"

# Hand off to the real init in the verified rootfs.
exec switch_root /mnt/root /sbin/init || rescue "switch_root failed"
